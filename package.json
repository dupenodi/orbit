{
  "name": "orbit",
  "version": "0.2.0",
  "description": "Hold a shortcut, flick toward an action, release.",
  "productName": "Orbit",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/ensure-mod-watch.js && electron .",
    "icon": "mkdir -p build && swiftc -O -o bin/make-app-icon scripts/make-app-icon.swift && bin/make-app-icon assets/icon.svg build/icon.icns",
    "dist": "node scripts/ensure-mod-watch.js && npm run icon && electron-builder --mac",
    "dist:win": "node scripts/ensure-mod-watch.js && electron-builder --win"
  },
  "author": "dupenodi",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dupenodi.orbit",
    "productName": "Orbit",
    "copyright": "© 2026 dupenodi",
    "asar": false,
    "files": [
      "**/*",
      "!**/*.swift",
      "!**/*.cs",
      "!scripts/**",
      "!build/**",
      "!dist/**",
      "!test/**",
      "!.github/**",
      "!NOTES.md",
      "!bin/make-app-icon",
      "!bin/make-tray-icon"
    ],
    "mac": {
      "target": [
        {
          "target": "dir"
        },
        {
          "target": "zip"
        },
        {
          "target": "dmg"
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Orbit asks System Events to switch light and dark mode, and Finder for its current folder."
      }
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Orbit-Setup-${version}.${ext}",
      "shortcutName": "Orbit"
    }
  }
}
